{
    "name": "moms-website",
    "main": "worker/index.ts",
    "compatibility_date": "2026-11-01",
    // The site is served only at prevenvar.com (and www). Kept here, not just in
    // the dashboard, so every deploy from GitHub keeps the same setup.
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        { "pattern": "prevenvar.com", "custom_domain": true },
        { "pattern": "www.prevenvar.com", "custom_domain": true }
    ],
    // Workers Logs: every request (URL, status, timing, errors) is viewable in
    // the dashboard (Worker → Observability). Free plan: 200k events/day, kept 3 days.
    // Set here so deploys don't switch it back off.
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    },
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*"
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "moms-website-db",
            "database_id": "87fc17a4-070b-4d3a-9973-b09d40caea04",
            "migrations_dir": "migrations"
        }
    ]
}

{
    "name": "prevenvar",
    "main": "worker/index.ts",
    "compatibility_date": "2026-11-01",
    // The site is served only at prevenvar.com (and www). Kept here, not just in
    // the dashboard, so every deploy from GitHub keeps the same setup.
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        { "pattern": "prevenvar.com", "custom_domain": true },
        { "pattern": "www.prevenvar.com", "custom_domain": true }
    ],
    // Observability (dashboard: Worker → Observability). Copied from the
    // dashboard's settings so deploys keep them exactly as they are there.
    //  - logs:   every request (URL, status, timing, errors).
    //  - traces: timeline of each request (e.g. how long each D1 call took).
    //  - issues: repeated errors grouped together.
    // redact_query_string is off: the site sends no private data in URLs
    // (passwords etc. go in POST bodies, which are never logged).
    "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "redact_query_string": false,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true
        },
        "issues": {
            "enabled": true
        }
    },
    "assets": {
        // Unknown paths get index.html (200), so links like /modulo3/... work.
        "not_found_handling": "single-page-application",
        // These go to the worker instead. Besides /api, the paths bots probe for
        // secrets (/.env, /.git/config, /wrangler.jsonc, ...): none of them
        // exist, and answering 404 instead of the home page tells scanners so.
        "run_worker_first": [
            "/api/*",
            "/.*",
            "/*/.*",
            "/wrangler.*",
            "/package*.json"
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "moms-website-db",
            "database_id": "87fc17a4-070b-4d3a-9973-b09d40caea04",
            "migrations_dir": "migrations"
        }
    ]
}

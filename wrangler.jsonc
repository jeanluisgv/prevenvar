{
    "name": "moms-website",
    "main": "worker/index.ts",
    "compatibility_date": "2026-11-01",
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*"
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "moms-website-db",
            "database_id": "87fc17a4-070b-4d3a-9973-b09d40caea04",
            "migrations_dir": "migrations"
        }
    ]
}
